log_format pulse_no_query '$remote_addr - $remote_user [$time_local] '
                          '"$request_method $uri $server_protocol" $status $body_bytes_sent '
                          '"$http_user_agent"';

server {
    listen 8443 ssl;
    listen [::]:8443 ssl;
    server_name _;
    server_tokens off;

    ssl_certificate /etc/nginx/tls/pulse.crt;
    ssl_certificate_key /etc/nginx/tls/pulse.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_tickets off;

    access_log /var/log/nginx/access.log pulse_no_query;
    error_log /var/log/nginx/error.log warn;

    root /usr/share/nginx/html;
    index index.html;

    include /etc/nginx/snippets/pulse-security-headers.conf;

    location ^~ /internal/ {
        return 404;
    }

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location = /api/v1/live {
        proxy_pass http://pulse-api:8081;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
        add_header X-Accel-Buffering no always;
        include /etc/nginx/snippets/pulse-security-headers.conf;
    }

    location /api/ {
        proxy_pass http://pulse-api:8081;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
    }

    location = /index.html {
        add_header Cache-Control "no-cache" always;
        include /etc/nginx/snippets/pulse-security-headers.conf;
        try_files $uri =404;
    }

    location ~* \.(?:js|css|woff2?)$ {
        try_files $uri =404;
        expires 7d;
        add_header Cache-Control "public, immutable" always;
        include /etc/nginx/snippets/pulse-security-headers.conf;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
