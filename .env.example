COMPOSE_PROJECT_NAME=pulse
PULSE_BIND_ADDRESS=0.0.0.0
PULSE_WEB_PORT=443
PULSE_DNSTAP_PORT=6000
PULSE_PUBLIC_NAME=pulse

PULSE_TENANT=default
PULSE_EXPECTED_SOURCES=
PULSE_ADMIN_USERNAME=admin
PULSE_VERSION=dev

CLICKHOUSE_IMAGE=clickhouse/clickhouse-server:26.3.36.6-alpine
ALPINE_IMAGE=alpine:3.21.3

# Replaced with cryptographically random values by install.sh.
CLICKHOUSE_ADMIN_USER=pulse_admin
CLICKHOUSE_ADMIN_PASSWORD=GENERATE_ON_INSTALL
CLICKHOUSE_API_USER=pulse_api
CLICKHOUSE_API_PASSWORD=GENERATE_ON_INSTALL
CLICKHOUSE_INGEST_USER=pulse_ingest
CLICKHOUSE_INGEST_PASSWORD=GENERATE_ON_INSTALL

PULSE_BATCH_SIZE=5000
PULSE_QUEUE_SIZE=100000
PULSE_FLUSH_INTERVAL_MS=500
PULSE_CORRELATION_TIMEOUT_MS=30000
PULSE_PENDING_FLUSH_MS=10
PULSE_PENDING_SYNC_MS=100
PULSE_PENDING_CHECKPOINT_MS=60000
PULSE_LIVE_QUEUE_SIZE=50000

PULSE_TLS_CERT_FILE=./.docker/tls/pulse.crt
PULSE_TLS_KEY_FILE=./.docker/tls/pulse.key
